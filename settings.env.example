# App
API_ID=11111
API_HASH=your_api_hash
PHONE_NUMBER=

# MySQL
MYSQL_IP=127.0.0.1
MYSQL_DB=my_database
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_ENABLED=true

# Redis
REDIS_IP=127.0.0.1
REDIS_ENABLED=true

# MCP
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000
SESSION_NAME=pyrogram_mcp
# Codex bridge
CODEX_BIN=codex
# Isolated Codex state for this project; existing ~/.codex/auth.json is reused.
CODEX_HOME=~/.local/share/pyrogram-mcp/codex
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=xhigh
CODEX_SERVICE_TIER=default
CODEX_TIMEOUT=180
CODEX_MCP_URL=http://127.0.0.1:8000/mcp
# Comma-separated absolute directories for file tools. Empty disables them.
MEDIA_ROOTS=/tmp/pyrogram-mcp-media
